# action: "list" | "add" | "update" | "delete"
string action
string key        # waypoint 식별자 (예: classroom_1)
string label      # 표시 이름 (예: 1강의실)
float64 x
float64 y
float64 yaw
---
bool success
string message
# list 액션 시 waypoints 전체를 JSON 문자열로 반환
# {"classroom_1": {"label":"1강의실","x":1.23,"y":4.56,"yaw":0.0}, ...}
string waypoints_json
