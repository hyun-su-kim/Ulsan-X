<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ulsan_obstacle_layer</name>
  <version>0.0.1</version>
  <description>
    Nav2 costmap 플러그인 패키지.
    Domain bridge를 통해 수신한 상대 로봇의 amcl_pose를
    global costmap에 LETHAL_OBSTACLE로 마킹해 멀티로봇 충돌을 방지한다.
    스레드 동기화는 std::atomic(lock-free)으로 구현해 costmap 루프(0.5Hz) 블로킹 없음.
  </description>
  <maintainer email="wego@todo.todo">wego</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Nav2 costmap Layer 인터페이스 -->
  <depend>nav2_costmap_2d</depend>
  <!-- amcl_pose 메시지 타입 -->
  <depend>geometry_msgs</depend>
  <!-- ROS2 노드, 구독, 로깅 -->
  <depend>rclcpp</depend>
  <!-- 플러그인 등록 및 로드 -->
  <depend>pluginlib</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
